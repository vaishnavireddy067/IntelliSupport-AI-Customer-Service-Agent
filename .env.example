# Environment variables for Hiver AI Support Agent

# Optional: Set your OpenAI, Anthropic, or other LLM API key for LLM-based response drafting and LLM judge.
# If left unset, the system automatically uses the deterministic retrieval fallback (100% functional without an API key).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# LLM model configuration
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2

# Random seed for reproducibility
RANDOM_SEED=42
